{
  "name": "n8n-nodes-klinky",
  "version": "0.1.0",
  "description": "n8n community node for Klinky smart link automation — create, update, and manage split links from workflows.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "klinky",
    "smart links",
    "url shortener",
    "ab testing",
    "marketing automation"
  ],
  "license": "MIT",
  "homepage": "https://klinky.io/integrations/n8n",
  "author": {
    "name": "Robin Wilgott",
    "email": "support@klinky.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilgott/n8n-nodes-klinky.git"
  },
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:watch": "tsc -p tsconfig.json --watch",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/KlinkyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Klinky/Klinky.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.39.4",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.2"
  }
}
